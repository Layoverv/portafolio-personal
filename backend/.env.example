# Copia este archivo como .env (en esta misma carpeta backend/) y completa los valores.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# Clave de la API de Gemini. Se obtiene gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo de Gemini. "gemini-flash-latest" apunta siempre al modelo Flash más reciente.
GEMINI_MODEL=gemini-flash-latest

# Puerto del servidor
PORT=3001

# Origen del frontend permitido por CORS (separa varios con comas)
FRONTEND_URL=http://localhost:5173
