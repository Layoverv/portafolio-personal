# Copia este archivo como .env y completa los valores.

# URL del backend. En desarrollo déjala vacía: Vite reenvía /api a http://localhost:3001.
# En producción pon la URL del backend publicado, por ejemplo https://mi-backend.onrender.com
VITE_API_URL=

# Endpoint de un servicio real de formularios, por ejemplo Formspree:
# https://formspree.io/f/xxxxxxxx  (crea un formulario gratis en formspree.io)
# Mientras esté vacío, el formulario avisa que no está conectado y no permite enviar.
VITE_FORM_ENDPOINT=
